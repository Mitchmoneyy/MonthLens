# Public site settings, used in every build. No secrets belong in this file.
# Moving to your own domain: change VITE_SITE_URL, add a public/CNAME file with the domain,
# and update the Site URL in Supabase (Authentication -> URL Configuration).
VITE_SITE_URL=https://mitchmoneyy.github.io/MonthLens/
# Optional: a support address shown on the Privacy & support page, e.g. hello@yourdomain.com
VITE_SUPPORT_EMAIL=
