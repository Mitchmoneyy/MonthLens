# Copy to .env.production to switch accounts on for the website and the iOS app.
# Both values are public by design (Supabase: Project Settings -> API). Row-level security in
# supabase/schema.sql is what keeps each account's data private. Never put a service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
